<Window x:Class="EasyPDF.Views.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:EasyPDF.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.Properties_Title}"
        Width="520"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeadingText"
                   FontSize="{StaticResource FontSizeLarge}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0" Padding="14,10">
            <ScrollViewer Style="{StaticResource AppScrollViewerStyle}" VerticalScrollBarVisibility="Auto">
                <!-- Label and value pairs; values can be selected and copied. -->
                <Grid x:Name="Rows" Grid.IsSharedSizeScope="True" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <TextBlock x:Name="AppVersion" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" />
            <Button HorizontalAlignment="Right"
                    Content="{x:Static res:Strings.Common_Close}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    IsCancel="True"
                    Click="OnClose" />
        </Grid>
    </Grid>
</Window>
