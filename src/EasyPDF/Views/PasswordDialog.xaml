<Window x:Class="EasyPDF.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:EasyPDF.Resources"
        Style="{StaticResource AppWindowStyle}"
        Title="{x:Static res:Strings.Password_Title}"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Window.Resources>
        <PathGeometry x:Key="LockIcon" Figures="M6,11 L18,11 L18,20 L6,20 Z M8.5,11 L8.5,7.5 A3.5,3.5 0 0 1 15.5,7.5 L15.5,11 M12,14.5 L12,16.5" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Path Grid.Column="0"
              Width="22" Height="22"
              Margin="0,2,12,0"
              VerticalAlignment="Top"
              Stretch="Uniform"
              Data="{StaticResource LockIcon}"
              Stroke="{DynamicResource AccentBrush}"
              StrokeThickness="1.6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round" />

        <StackPanel Grid.Column="1">
            <TextBlock Text="{x:Static res:Strings.Password_Title}"
                       FontSize="{StaticResource FontSizeMedium}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="PromptText"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="19" />

            <PasswordBox x:Name="PasswordInput"
                         Margin="0,12,0,0"
                         Style="{StaticResource AppPasswordBoxStyle}"
                         AutomationProperties.Name="{x:Static res:Strings.Password_Title}"
                         PasswordChanged="OnPasswordChanged" />

            <TextBlock x:Name="ErrorText"
                       Margin="0,8,0,0"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="{x:Static res:Strings.Password_Wrong}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{x:Static res:Strings.Common_Cancel}" Style="{StaticResource SecondaryButtonStyle}" IsCancel="True" />
                <Button x:Name="OkButton"
                        Margin="8,0,0,0"
                        Content="{x:Static res:Strings.Password_Open}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
