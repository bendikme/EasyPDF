<Window x:Class="EasyPDF.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:EasyPDF.Resources"
        Style="{StaticResource AppWindowStyle}"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <!-- Asks before a document gets to open something outside itself. What would be opened is
         shown in full, selectable, so the reader can check it - or copy it - first. Enter does
         not accept: going ahead takes a deliberate click. -->

    <Window.Resources>
        <PathGeometry x:Key="ConfirmIconLink"
                      Figures="M10,14 A4,4 0 0 0 15.66,14 L18.5,11.17 A4,4 0 0 0 12.83,5.5 L11.5,6.83 M14,10 A4,4 0 0 0 8.34,10 L5.5,12.83 A4,4 0 0 0 11.17,18.5 L12.5,17.17" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Width="22" Height="22"
                  Margin="0,2,12,0"
                  VerticalAlignment="Top"
                  Stretch="Uniform"
                  Data="{StaticResource ConfirmIconLink}"
                  Stroke="{DynamicResource AccentBrush}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" />

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadingText"
                           FontSize="{StaticResource FontSizeMedium}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Margin="0,6,0,0"
                           FontSize="{StaticResource FontSizeNormal}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           LineHeight="19" />
                <TextBox x:Name="TargetText"
                         Margin="0,10,0,0"
                         Style="{StaticResource AppTextBoxStyle}"
                         IsReadOnly="True"
                         IsTabStop="True"
                         TextWrapping="Wrap"
                         MaxHeight="120"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas"
                         FontSize="{StaticResource FontSizeSmall}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton"
                    Content="{x:Static res:Strings.Common_Cancel}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    IsDefault="True" />
            <Button x:Name="ConfirmButton"
                    Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnConfirm" />
        </StackPanel>
    </Grid>
</Window>
